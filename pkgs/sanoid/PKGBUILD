# Maintainer: Mark Wells <contact at markwells dot dev>
# shellcheck shell=bash disable=SC2034,SC2154,SC2164
pkgname=sanoid
pkgver=2.3.0
pkgrel=1
pkgdesc="Policy-driven snapshot management and replication for ZFS (sanoid + syncoid)"
arch=('any')
url="https://github.com/jimsalterjrs/sanoid"
license=('GPL-3.0-or-later')
depends=(
    'perl'
    'perl-config-inifiles'
    'perl-capture-tiny'
)
optdepends=(
    'zfs-utils: ZFS commands required by sanoid/syncoid (or any zfs provider)'
    'mbuffer: network buffering for syncoid'
    'pv: transfer progress for syncoid'
    'lzop: compression for syncoid'
    'gzip: compression for syncoid'
    'pigz: parallel gzip compression for syncoid'
    'zstd: zstd compression for syncoid'
    'lz4: lz4 compression for syncoid'
)
backup=('etc/sanoid/sanoid.conf')
makedepends=('git')
# Upstream attaches no artifacts or digests to its releases, and GitHub's
# generated tag tarballs are not guaranteed byte-stable — so the source is
# pinned by commit and verified by git's content addressing (SKIP is sound
# here: there is no tarball hash that could be). The watcher keeps _commit
# in step with pkgver.
_commit=8d4abf14b2bf8d6b98fc8e163fa9895486e8cdeb
source=("git+$url.git#commit=$_commit")
sha512sums=('SKIP')

prepare() {
    cd "$pkgname"
    # Units ship with /usr/sbin paths; this package installs binaries to /usr/bin.
    sed -i 's|/usr/sbin|/usr/bin|g' \
        packages/debian/sanoid.service \
        packages/debian/sanoid.timer \
        packages/debian/sanoid.sanoid-prune.service
}

package() {
    cd "$pkgname"

    install -Dm755 -t "$pkgdir/usr/bin/" sanoid syncoid findoid

    install -Dm644 sanoid.conf "$pkgdir/etc/sanoid/sanoid.conf"
    install -Dm644 sanoid.defaults.conf "$pkgdir/etc/sanoid/sanoid.defaults.conf"

    install -Dm644 packages/debian/sanoid.service "$pkgdir/usr/lib/systemd/system/sanoid.service"
    install -Dm644 packages/debian/sanoid.timer "$pkgdir/usr/lib/systemd/system/sanoid.timer"
    install -Dm644 packages/debian/sanoid.sanoid-prune.service \
        "$pkgdir/usr/lib/systemd/system/sanoid-prune.service"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
# vim:set ts=2 sw=2 et:
