)
# Built from the PyPI sdist rather than the GitHub tag archive: PyPI files
# are immutable and the registry publishes their sha256, so the watcher pins
# a claim instead of hashing a download (see PROVENANCE.md). The MIT LICENSE
# is not guaranteed inside the sdist, so it is fetched from the tagged tree.
source=("https://files.pythonhosted.org/packages/source/k/keepercommander/keepercommander-$pkgver.tar.gz"
    "LICENSE-$pkgver::https://raw.githubusercontent.com/Keeper-Security/Commander/v$pkgver/LICENSE")
sha256sums=('9bd012e2ec82f96411a878e38ece432903f765134b2a76cec6d093f52b8fd924'
    'a6538169baa044f5f780a8a4533c9c434e6e3d97ead370d2ad6f280f204389fd')

build() {
    cd "keepercommander-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "keepercommander-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -D -m644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
