# Maintainer: Mark Wells <contact at markwells dot dev>
# shellcheck shell=bash disable=SC2034,SC2154
pkgname=perl-config-inifiles
_dist=Config-IniFiles
pkgver=3.003000
pkgrel=1
pkgdesc="A module for reading and writing .ini-style configuration files"
arch=('any')
url="https://metacpan.org/dist/Config-IniFiles"
license=('PerlArtistic' 'GPL')
depends=(
    'perl'
    'perl-io-stringy'
)
source=("https://cpan.metacpan.org/authors/id/S/SH/SHLOMIF/${_dist}-${pkgver}.tar.gz")
sha512sums=('35021488064ba370584184df5af9f1e6d81c58464d17152fdc7a54c2616fcfc0b4e6393bd67cd429da8df567d91a2ea65449977c64604c82cbf7f57fd730ec9b')

build() {
    cd "$_dist-$pkgver"
    perl Makefile.PL INSTALLDIRS=vendor
    make
}

check() {
    cd "$_dist-$pkgver"
    make test
}

package() {
    cd "$_dist-$pkgver"
    make install DESTDIR="$pkgdir"
    # Perl bookkeeping files must not ship in the package.
    find "$pkgdir" \( -name '.packlist' -o -name 'perllocal.pod' \) -delete
}
# vim:set ts=2 sw=2 et:
